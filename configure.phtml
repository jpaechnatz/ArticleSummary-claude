<?php
$userConf = FreshRSS_Context::$user_conf;
$oai_url = isset($userConf->oai_url) ? $userConf->oai_url : '';
$oai_key = isset($userConf->oai_key) ? $userConf->oai_key : '';
$has_oai_key = !empty($oai_key);
$oai_model = isset($userConf->oai_model) ? $userConf->oai_model : '';
$oai_prompt = isset($userConf->oai_prompt) ? $userConf->oai_prompt : '';
$oai_provider = isset($userConf->oai_provider) && $userConf->oai_provider ? $userConf->oai_provider : 'openai';
$oai_temperature = isset($userConf->oai_temperature) ? $userConf->oai_temperature : null;
$oai_max_tokens = isset($userConf->oai_max_tokens) ? $userConf->oai_max_tokens : null;

$display_temperature = ($oai_temperature === null || $oai_temperature === '') ? '' : (float)$oai_temperature;
$display_max_tokens = ($oai_max_tokens === null || $oai_max_tokens === '' || (int)$oai_max_tokens === 0)
  ? ''
  : (int)$oai_max_tokens;
?>

<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
  <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />
  <label for="oai_provider">Choose AI Provider</label>
  <select name="oai_provider">
      <option value="openai" <?php echo ($oai_provider == 'openai' ? 'selected' : ''); ?>>OpenAI</option>
      <option value="mistral" <?php echo ($oai_provider == 'mistral' ? 'selected' : ''); ?>>Mistral (OpenAI compatible)</option>
      <option value="ollama" <?php echo ($oai_provider == 'ollama' ? 'selected' : ''); ?>>Ollama</option>
   </select>
 
 <div id="common_config">
    <label for="oai_url">Base URL (http(s)://oai.com/) without 'v1'</label>
    <input type="text" name="oai_url" id="oai_url" value="<?php echo htmlspecialchars($oai_url, ENT_QUOTES, 'UTF-8'); ?>">
    <label for="oai_key">API Key</label>
    <input type="password"
           name="oai_key"
           id="oai_key"
           value=""
           autocomplete="new-password"
           placeholder="<?php echo $has_oai_key ? '••••••••' : ''; ?>">
    <small>Leave blank to keep the existing key.</small>
    <?php if ($has_oai_key) { ?>
      <div class="oai-key-clear">
        <label>
          <input type="checkbox" name="clear_oai_key" value="1">
          Remove stored key
        </label>
      </div>
    <?php } ?>
    <label for="oai_model">Model Name</label>
    <input type="text" name="oai_model" id="oai_model" value="<?php echo htmlspecialchars($oai_model, ENT_QUOTES, 'UTF-8'); ?>">
    <label for="oai_temperature">Temperature</label>
    <input type="number"
           step="0.1"
           min="0"
           max="2"
           name="oai_temperature"
           id="oai_temperature"
           value="<?php echo htmlspecialchars($display_temperature, ENT_QUOTES, 'UTF-8'); ?>">
    <small>Leave empty to use the provider default. Some OpenAI GPT-5 models require the default temperature of 1.0 and will ignore other values.</small>
    <label for="oai_max_tokens">Max tokens</label>
    <input type="number"
           min="0"
           name="oai_max_tokens"
           id="oai_max_tokens"
           value="<?php echo htmlspecialchars($display_max_tokens, ENT_QUOTES, 'UTF-8'); ?>">
    <small>Leave empty or set 0 to let the provider decide.</small>
    <label for="oai_prompt">Prompt (add before content)</label>
    <textarea name="oai_prompt" id="oai_prompt"><?php echo htmlspecialchars($oai_prompt, ENT_QUOTES, 'UTF-8'); ?></textarea>
  </div>
  <hr />
  <button type="submit">Save</button>
</form>
